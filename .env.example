# Copy to .env. These required settings have no application defaults.

# Native API binding / Docker published address (internal Docker port stays 8000)
# Non-loopback hosts expose the unauthenticated development API
SEIRETH_API_HOST=127.0.0.1
SEIRETH_API_PORT=8000

# Sandbox backend
SEIRETH_SANDBOX_BACKEND=inmemory

# Docker target images allowed to run in the sandbox
SEIRETH_DOCKER_TARGET_IMAGE=seireth/demo-target:local
SEIRETH_DOCKER_ALLOWED_TARGET_IMAGES=["seireth/demo-target:local"]

# Local development only. Change both values together; use URL-safe credentials.
POSTGRES_PASSWORD=seireth-local
SEIRETH_DATABASE_URL=postgresql+psycopg://seireth:seireth-local@127.0.0.1:5432/seireth
SEIRETH_ASSESSMENT_TIMEOUT_SECONDS=60
