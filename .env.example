# Copy to .env for local overrides. Defaults live in app/config.py.
#
# Security and deployment decisions:
SEIRETH_ENVIRONMENT=local
SEIRETH_SANDBOX_BACKEND=inmemory
SEIRETH_DOCKER_ALLOWED_TARGET_IMAGES=["seireth/demo-target:local"]

# Required outside local development. Use a secret manager in deployment.
# SEIRETH_API_KEY=replace-with-a-long-random-secret
