# Copy to .env for local development.

# Native API binding / Docker published address
# Non-loopback hosts expose the unauthenticated development API
SEIRETH_API_HOST=127.0.0.1
SEIRETH_API_PORT=8000

# Target kind selects real Docker bundle or website execution

# Optional operator-owned request/launch/network/trust profiles
# SEIRETH_OPERATOR_CONFIG_FILE=/absolute/path/operator.json
# SEIRETH_BUNDLE_RUNNER_IMAGE=seireth/runner:local
# SEIRETH_CLEANUP_TIMEOUT_SECONDS=60

# Local development credentials; change both values together
POSTGRES_PASSWORD=seireth-local
SEIRETH_DATABASE_URL=postgresql+psycopg://seireth:seireth-local@127.0.0.1:5432/seireth
